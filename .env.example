# Copy this file to .env and fill in real values. One file for both the
# Next.js app (public site + /admin panel, at the repo root) and the Express
# API (server/) — Next loads this automatically, and server/bootstrap.js
# loads it explicitly.

# --- Frontend (public site + /admin) -----------------------------------------

# Base URL of the Express API (see server/index.js's PORT below).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public site URL, used for absolute URLs in SEO metadata / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Backend (server/) --------------------------------------------------------

PORT=4000

# MongoDB Atlas connection string (include the database name at the end).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soil_structure

# Signing secret for admin JWTs — any long random string.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Static admin login (no admin database — see server/routes/auth.js).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Must match the origin the Next.js app runs on.
CORS_ORIGIN=http://localhost:3000

# Cloudinary (used for project image uploads — see server/routes/upload.js).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (used for the contact form — see server/routes/contact.js). Point this
# at a Mailtrap sandbox inbox while developing; swap for live SMTP in prod.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# Mailbox that receives contact-form submissions.
CONTACT_TO_EMAIL=hello@soilandstructure.example
# From address on outgoing contact-form emails (sandbox providers only deliver
# to the sandbox inbox regardless of this value).
MAIL_FROM="Soil & Structure Website" <no-reply@soilandstructure.example>
