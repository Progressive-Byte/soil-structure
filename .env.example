# Copy this file to .env.local and fill in real values.

# Base URL of the future Node.js API layer. Unused in the static phase, but the
# data layer (/lib/data/*) reads it so switching to live data needs no wiring.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public site URL, used for absolute URLs in SEO metadata / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
