# Copy this file to .env and fill in real values. One file for both the
# Next.js app (frontend/, public site + /admin panel) and the Express API
# (server/) — frontend/next.config.mjs and server/bootstrap.js both load this
# root .env directly.

# --- Frontend (frontend/) ----------------------------------------------------

# Base URL of the Express API (see server/index.js's PORT below).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public site URL, used for absolute URLs in SEO metadata / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Backend (server/) --------------------------------------------------------

PORT=4000

# MongoDB Atlas connection string (include the database name at the end).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soil_structure

# Signing secret for admin JWTs — any long random string.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Static admin login (no admin database — see server/routes/auth.js).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Must match the origin the Next.js app runs on.
CORS_ORIGIN=http://localhost:3000

# Cloudinary (used for project image uploads — see server/routes/upload.js).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
