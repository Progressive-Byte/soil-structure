# Copy this file to .env and fill in real values. One file for all four apps
# (frontend/web, frontend/admin, frontend/login, server) — each Next app's
# next.config.mjs and server/bootstrap.js all load this root .env directly.

# --- Frontend: frontend/web (public site) -----------------------------------

# Base URL of the Express API (see server/index.js's PORT below).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public site URL, used for absolute URLs in SEO metadata / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Frontend: frontend/admin + frontend/login -------------------------------

# admin/ and login/ run as separate apps on separate ports — each needs to
# know the other's URL to redirect between them after login/logout.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_LOGIN_URL=http://localhost:3002

# --- Backend: server/ --------------------------------------------------------

PORT=4000

# MongoDB Atlas connection string (include the database name at the end).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soil_structure

# Signing secret for admin JWTs — any long random string.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Static admin login (no admin database — see server/routes/auth.js).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Comma-separated — must include every origin that calls this API
# (web, admin and login all run on different ports).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Cloudinary (used for project image uploads — see server/routes/upload.js).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
