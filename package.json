{
  "name": "soil-structure",
  "version": "0.1.0",
  "private": true,
  "description": "Soil & Structure — geotechnical and structural engineering consultancy website, with a Node/Express + MongoDB API for the Projects admin panel.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",

    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",

    "dev:all": "concurrently \"npm:dev\" \"npm:server:dev\""
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.16",
    "multer-storage-cloudinary": "^4.0.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
