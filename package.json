{
  "name": "soil-structure",
  "version": "0.1.0",
  "private": true,
  "description": "Soil & Structure — geotechnical and structural engineering consultancy website, with a Node/Express + MongoDB API for the Projects admin panel.",
  "scripts": {
    "dev": "cd frontend/web && next dev -p 3000",
    "build": "cd frontend/web && next build",
    "start": "cd frontend/web && next start -p 3000",
    "lint": "cd frontend/web && next lint",
    "typecheck": "cd frontend/web && tsc --noEmit",

    "admin:dev": "cd frontend/admin && next dev -p 3001",
    "admin:build": "cd frontend/admin && next build",
    "admin:start": "cd frontend/admin && next start -p 3001",

    "login:dev": "cd frontend/login && next dev -p 3002",
    "login:build": "cd frontend/login && next build",
    "login:start": "cd frontend/login && next start -p 3002",

    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",

    "dev:all": "concurrently \"npm:dev\" \"npm:admin:dev\" \"npm:login:dev\" \"npm:server:dev\""
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
